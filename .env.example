# ===========================================
# PostgreSQL Database (Neon free tier)
# ===========================================
# 1. Sign up at https://neon.tech
# 2. Create a new project (any region)
# 3. Copy the POOLED connection string (contains -pooler) and paste below
DATABASE_URL="postgresql://neondb_owner:your-password@ep-xxxxx-pooler.us-east-2.aws.neon.tech/performance_system?sslmode=require"

# ===========================================
# Backend Server Settings
# ===========================================
# JWT secret for signing authentication tokens (use a long random string)
JWT_SECRET="your-super-secret-key-change-this-in-production"

# Server port (Render.com assigns this automatically via PORT env var)
PORT=3000

# Comma-separated list of allowed CORS origins for cross-origin API requests
# Example: https://chantha-cmd-web.github.io,https://your-app.onrender.com
CORS_ORIGINS=""

# ===========================================
# Frontend Build Settings (Vite)
# ===========================================
# The full URL of your backend API (used when frontend is on a different domain)
# For Render.com full-stack deployment: leave empty (same-origin)
# For GitHub Pages + separate backend: set to your Render.com URL
# Example: VITE_API_URL="https://your-app.onrender.com"
VITE_API_URL=""

# Environment: development or production
NODE_ENV=development
