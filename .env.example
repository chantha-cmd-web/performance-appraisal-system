# DATABASE_URL: PostgreSQL connection string (Neon free tier)
# Sign up at https://neon.tech - create a database and paste the connection string here.
# Use the pooled connection string (includes -pooler) for production.
DATABASE_URL="postgresql://neondb_owner:your-password@ep-xxxxx.us-east-2.aws.neon.tech/performance_system?sslmode=require"

# JWT_SECRET: Secret key for JWT token signing (use a strong random string)
JWT_SECRET="your-super-secret-key-change-this-in-production"

# PORT: Server port (Render.com assigns this automatically via PORT env var)
PORT=3000

# NODE_ENV: production or development
NODE_ENV=development
